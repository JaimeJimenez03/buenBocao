# ================================
# DATABASE: MYSQL
# ================================
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:3306/buenBocao?serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# ================================
# APP
# ================================
APP_BASE_URL=https://your-domain.com/api/v1
APP_VERSION_MIN_ANDROID=1.0.0
APP_VERSION_MIN_IOS=1.0.0
APP_MAINTENANCE=false
APP_MAINTENANCE_MESSAGE=Estamos realizando mejoras. Vuelve pronto.

# CORS — lista separada por comas de orígenes permitidos
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ================================
# JWT
# ================================
# Generar con: openssl rand -base64 64
SECURITY_JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_64
SECURITY_JWT_EXPIRATION_TIME=3600000

# ================================
# SMTP (Gmail)
# ================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# ================================
# RED / SERVER
# ================================
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SPRING_SQL_INIT_MODE=never
SPRING_SQL_INIT_PLATFORM=mysql

# ================================
# TWILIO (SMS)
# ================================
TWILIO_ACCOUNTSID=your_twilio_account_sid
TWILIO_AUTHTOKEN=your_twilio_auth_token
TWILIO_PHONENUMBER=+1XXXXXXXXXX

# ================================
# REDIS
# ================================
REDIS_URL=redis://:your_redis_password@HOST:6379

# ================================
# STRIPE
# ================================
SK_TEST=sk_test_...
PK_TEST=pk_test_...
WEBHOOK=whsec_...

STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
